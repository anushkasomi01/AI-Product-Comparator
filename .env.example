# Copy to .env, then load it in your shell. Spring Boot does not load .env itself.
# Never put real secrets in this example file or commit .env.

# Local development is the default; no API key is required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Lower-memory alternative: qwen2.5:3b-instruct

# Optional: activate the hosted profile with SPRING_PROFILES_ACTIVE=hosted.
# Set the real key only in your shell, IDE run configuration, or secret manager.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com

# Local bind address. Use 0.0.0.0 only in a trusted container/preview network.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# One total Ollama attempt by default; increase deliberately if needed.
AI_MAX_ATTEMPTS=1
AI_CONNECT_TIMEOUT=5s
AI_READ_TIMEOUT=60s
# OpenAI retries are additional attempts; zero means one total attempt.
OPENAI_MAX_RETRIES=0
